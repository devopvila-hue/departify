{
  "name": "@departify/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@departify/agent-tool-bridge": "workspace:^",
    "@departify/auth": "workspace:^",
    "@departify/business-discovery": "workspace:^",
    "@departify/business-events": "workspace:^",
    "@departify/capability-engine": "workspace:^",
    "@departify/config": "workspace:*",
    "@departify/departments": "workspace:^",
    "@departify/engine-adapter": "workspace:^",
    "@departify/executive-director": "workspace:^",
    "@departify/executive-orchestrator": "workspace:^",
    "@departify/llm-provider-openai": "workspace:^",
    "@departify/llm-router": "workspace:^",
    "@departify/marketing-director": "workspace:*",
    "@departify/memory": "workspace:*",
    "@departify/memory-engine": "workspace:*",
    "@departify/platform-composition": "workspace:^",
    "@departify/tool-catalog": "workspace:^",
    "@departify/tool-runtime": "workspace:^",
    "@departify/workflows": "workspace:^",
    "@fastify/cors": "^10.0.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@supabase/supabase-js": "2.112.1",
    "fastify": "^5.2.1",
    "imapflow": "^1.6.6",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "light-my-request": "6.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
