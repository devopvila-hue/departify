# Portal — Vite reads these at build/dev time. Copy this file to .env for
# local development (they are PUBLIC variables: the anon/publishable key is
# safe for the browser. The service-role key NEVER belongs here.)
#
# In Netlify, set these in the build environment instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
