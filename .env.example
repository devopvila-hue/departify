# Departify environment contract — Phase P0-A.
#
# Copy to `.env` for local development and configure the same variables in the
# deployment platforms (Railway for the backend, Netlify for the portal).
# NO REAL SECRETS ARE COMMITTED HERE — fill in real values in your own .env.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3210
LOG_LEVEL=info

# --- Identity / tenant access (P0-A) ----------------------------------------
# Supabase project for Auth + organizations. Service-role key is BACKEND ONLY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public portal origin. Used to build OAuth redirect URIs and absolute links.
PUBLIC_BASE_URL=http://localhost:3000
# Optional API host for provider OAuth redirects. Production defaults to the
# canonical https://api.departify.app callback bridge when unset.
PUBLIC_API_BASE_URL=https://api.departify.app

# Comma-separated browser origins allowed to call the API directly (CORS).
# Leave empty to stay same-origin only. Example: https://app.departify.app
CORS_ALLOWED_ORIGINS=

# --- LLM --------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=openai
LLM_ROUTING_STRATEGY=capability_first
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
# Optional OpenAI-compatible gateway endpoint (local dev).
OPENAI_BASE_URL=

# --- Mautic connector (Sprint 61) -------------------------------------------
MAUTIC_BASE_URL=
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=

# --- TikTok read connectors (server-only OAuth clients) --------------------
# Login Kit / Display API: user.info.basic + video.list.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok for Business Marketing API: keep this limited to approved READ scopes.
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
TIKTOK_BUSINESS_SCOPES=

# --- Hostinger business email (server-only remote MCP adapter) --------------
# Configure the real token only in the backend secret environment (Railway).
# The portal and model never receive this value.
HOSTINGER_EMAIL_MCP_URL=https://mcp.mail.hostinger.com/mcp
HOSTINGER_EMAIL_MCP_TOKEN=

# --- Observability (parsed but not yet wired to an exporter) ----------------
OTEL_SERVICE_NAME=departify-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false
TRACING_ENABLED=false

# --- Deployment metadata ------------------------------------------------------
RAILWAY_ENVIRONMENT=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=60
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# --- PORTAL (Netlify build env or apps/portal/.env) --------------------------
# The portal uses the ANON/publishable key only. The service-role key never
# reaches the browser. See apps/portal/.env.example.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- ENGINE ADAPTER (Sprint ENGINE 02) ---------------------------------------
# Provider-independent engine boundary. The backend obtains the adapter via
# createEngineAdapter(loadEngineAdapterConfig()). OpenClaw stays hidden.
ENGINE_PROVIDER=openclaw
# Gateway WebSocket URL. Local dev: ws://127.0.0.1:18889. Railway later:
# ws://<engine-service>.railway.internal:18889 (private network only).
OPENCLAW_GATEWAY_URL=
# Backend-only secret; never sent to the portal. Must match the engine's token.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_REQUEST_TIMEOUT_MS=120000
OPENCLAW_CONNECT_TIMEOUT_MS=15000
OPENCLAW_RETRY_LIMIT=2
OPENCLAW_MAX_RETRY_DELAY_MS=8000
# Path to a persisted Ed25519 PEM used for gateway device auth (gitignored,
# e.g. .devkeys/openclaw-device.json -> key.pem).
OPENCLAW_DEVICE_KEY_PATH=
# Optional default model override (provider/model).
OPENCLAW_MODEL=

# --- ACTIVEPIECES CONNECTOR RUNTIME (PoC) -----------------------------------
# Activepieces runs as an independent Railway service. The backend uses its
# private Railway hostname; provider credentials remain inside Activepieces
# connections/flows and never enter OpenClaw, the portal, or model input.
ACTIVEPIECES_BASE_URL=
ACTIVEPIECES_WEBHOOK_SIGNING_SECRET=
ACTIVEPIECES_META_ADS_WEBHOOK_PATH=
ACTIVEPIECES_CONNECTOR_TIMEOUT_MS=30000

# --- FIRST-PARTY ADS RUNTIMES -----------------------------------------------
# Optional official MCP endpoints. The backend discovers tools at runtime;
# empty means unavailable, never connected. Meta's current official endpoint
# is remote; TikTok/Google endpoints are intentionally deployment-configured.
META_ADS_MCP_ENDPOINT=https://mcp.facebook.com/ads
TIKTOK_ADS_MCP_ENDPOINT=
GOOGLE_ADS_MCP_ENDPOINT=
# Optional official Google Ads API write path. Values belong in Railway
# secrets only; never commit them or send them to OpenClaw/model context.
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
