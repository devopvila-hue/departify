# Departify Golden Image environment
# Copy to .env for local development. Do not commit real values.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3210

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Railway
RAILWAY_ENVIRONMENT=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=60

# Netlify
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Anthropic
ANTHROPIC_API_KEY=

# Gemini
GEMINI_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# JWT
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Logging
LOG_LEVEL=info

# Observability
OTEL_SERVICE_NAME=departify-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false
TRACING_ENABLED=false
