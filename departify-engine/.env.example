# Departify Engine — environment contract
# Copy to .env and fill in real values. Never commit a populated copy.
# This file is a contract: the renderer reads only the names listed here.

# ───────────── OpenClaw runtime ─────────────
# Founder development parity boundary. Use "production" for the future
# hardened policy; that policy is intentionally a separate sprint.
DEPARTIFY_OPENCLAW_MODE=founder-development
# Version pinned to the official Latest release (2026-08-04).
OPENCLAW_VERSION=v2026.7.1-2
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-2-slim

# Bind mode. Use "loopback" on Railway and rely on the private network.
# Use "lan" only when local testing requires the host to reach the gateway.
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_PORT=18889

# REQUIRED. Long random string. The renderer writes it to openclaw.json
# under gateway.auth.token and to /home/node/.openclaw/.env for the CLI.
# Generate with: openssl rand -hex 48
OPENCLAW_GATEWAY_TOKEN=

# ───────────── Model provider (default: Google Vertex) ─────────────
# Primary provider. Official OpenClaw plugin "google-vertex" uses gcloud
# Application Default Credentials (ADC). Set the provider/model refs and the
# ADC mount below. Alternatively set OPENCLAW_MODEL_PROVIDER=ollama to use the
# local Ollama fallback as the primary.
OPENCLAW_MODEL_PROVIDER=google-vertex
OPENCLAW_MODEL_NAME=gemini-2.5-flash
# Not needed for google-vertex (ADC handles auth). Kept for custom providers.
OPENCLAW_MODEL_BASE_URL=
OPENCLAW_MODEL_API_KEY=

# ───────────── Google Vertex (ADC) ─────────────
# Local dev: the host ADC file is mounted read-only into the container at
# /home/node/.config/gcloud/application_default_credentials.json by
# docker-compose.yaml. The Gateway resolves it via GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=radar-503418
GOOGLE_CLOUD_LOCATION=us-central1
# Host path used only by docker-compose to mount the ADC file. Leave empty to
# default to ~/.config/gcloud/application_default_credentials.json.
GOOGLE_ADC_FILE=

# ───────────── Fallback provider (optional local Ollama) ─────────────
# Ollama runs on the host; the container reaches it via host.docker.internal.
OPENCLAW_FALLBACK_PROVIDER=ollama
OPENCLAW_FALLBACK_MODEL=qwen3:0.6b
OPENCLAW_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
OPENCLAW_FALLBACK_API_KEY=ollama

# ───────────── Runtime behaviour ─────────────
OPENCLAW_DISABLE_BONJOUR=1
# Required for ws:// to private hosts. Off in production unless on tailnet.
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=0
OPENCLAW_DM_SCOPE=main
OPENCLAW_SESSION_RESET_MODE=none
OPENCLAW_LOG_LEVEL=info
OPENCLAW_MAX_TOKENS=2048
OPENCLAW_CONTEXT_TOKENS=131072
OPENCLAW_TEMPERATURE=0.2
OPENCLAW_REQUEST_TIMEOUT_SECONDS=300
OPENCLAW_TZ=UTC

# ───────────── Security / sandboxing ─────────────
# 0: native OpenClaw tools run on the gateway host. Founder parity follows
# the native runtime; production hardening is a separate future sprint.
OPENCLAW_SANDBOX=0
# Retained for the production policy branch. Founder parity ignores this
# narrow test/locked selector and uses the native full tool surface.
OPENCLAW_EXEC_MODE=test
# 1 publishes the gateway on 0.0.0.0 inside the container; keep 0.
OPENCLAW_EXPOSE_PUBLIC=0
# Comma-separated CIDRs allowed to be treated as "loopback" via forwarded
# headers when behind a trusted reverse proxy. Empty for now.
OPENCLAW_TRUSTED_PROXIES=

# ───────────── Observability ─────────────
# OpenTelemetry export (outbound only; the gateway has no published port for
# traces/metrics). Empty by default. Set to a collector URL when ready.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=departify-engine

# ───────────── Engine identity ─────────────
ENGINE_VERSION=engine-01-2026.08.09
